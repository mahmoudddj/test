# Copy to infrastructure/.env and replace EVERY value. Never commit the real .env.
IRTCRI_ENV=staging
POSTGRES_DB=irtcri
POSTGRES_USER=irtcri
POSTGRES_PASSWORD=change-me-long-random
MINIO_ROOT_USER=change-me-admin
MINIO_ROOT_PASSWORD=change-me-long-random
IRTCRI_S3_ACCESS_KEY=irtcri-app
IRTCRI_S3_SECRET_KEY=change-me-long-random
# One-time token used to create the first Admin via POST /api/v1/auth/bootstrap; remove afterwards.
IRTCRI_BOOTSTRAP_ADMIN_TOKEN=change-me-long-random
PUBLIC_UI_ORIGIN=https://irtcri.example.org
PUBLIC_API_BASE=https://irtcri.example.org
RAW_RETENTION_DAYS=5475
MLFLOW_TRACKING_URI=
# To open the app from other devices on your network (phone, other PCs), set the server's IP address:
#   BIND_ADDRESS=0.0.0.0
#   PUBLIC_API_BASE=http://192.168.1.50:8000
#   PUBLIC_UI_ORIGIN=http://192.168.1.50:3000
# then rebuild: docker compose up -d --build   (use HTTPS via a reverse proxy before any real data)
BIND_ADDRESS=127.0.0.1
